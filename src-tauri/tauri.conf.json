{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudMusic-Rust",
  "version": "0.1.0",
  "identifier": "com.netease.cloudmusic.rust",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "网易云音乐",
        "width": 1020,
        "height": 670,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
